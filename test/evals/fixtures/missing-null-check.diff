@@ -0,0 +1,8 @@
+// user is looked up by id and may be missing if the id is stale.
+export function displayName(user) {
+  return user.nickname || user.email.split('@')[0];
+}
+
+export function greet(user) {
+  return `Hello, ${displayName(user)}!`;
+}
